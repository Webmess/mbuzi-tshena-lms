# Copy this file to backend/.env and fill in the values.
# NEVER commit backend/.env - it contains passwords.

APP_NAME=Mbudzi Tshena LMS API
DEBUG=True
# Any long random text. Make one with:
#   .\venv\Scripts\python.exe -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM=HS256

# Shared Neon database - ask the team for the connection string (send it privately, never in GitHub)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require&channel_binding=require

FRONTEND_URL=http://localhost:5173

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=mbudzi.tshena.lms@gmail.com
SMTP_PASSWORD=ask-the-team
SMTP_FROM=loans@mbudzitshena.co.za
EMAIL_ENABLED=True

UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10